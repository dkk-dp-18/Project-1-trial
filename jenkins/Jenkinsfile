pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend Test') {
            steps {
                sh '''
                    docker run --rm \
                    -v jenkins_home:/workspace \
                    -w /workspace/workspace/employee-devops-pipeline/back-end \
                    maven:3.9-eclipse-temurin-17 \
                    mvn test
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    docker build -t faizankkdp/employee-backend:1.0 ./back-end
                    docker build -t faizankkdp/employee-frontend:1.0 ./front-end
                '''
            }
        }

        stage('Push Docker Images') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker push faizankkdp/employee-backend:1.0
                        docker push faizankkdp/employee-frontend:1.0
                        docker logout
                    '''
                }
            }
        }

    }
}